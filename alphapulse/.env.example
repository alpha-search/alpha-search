# ----- AlphaPulse environment -----
# Copy to .env and adjust. Defaults work with the bundled docker-compose stack.

# --- Backend / datastores ---
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://alphapulse:alphapulse@db:5432/alphapulse
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please-generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Stripe (use *_mock to run the offline mock flow) ---
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
STRIPE_PRICE_PREMIUM=price_premium_mock
STRIPE_PRICE_PRO=price_pro_mock

# --- Market data (FMP / Polygon-shaped). Mock mode needs no key. ---
USE_MOCK_MARKET_DATA=true
MARKET_DATA_API_KEY=demo
MARKET_DATA_BASE_URL=https://financialmodelingprep.com/api/v3

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# Browser talks to the backend through the Next.js rewrite proxy by default.
NEXT_PUBLIC_API_BASE=/api/backend
BACKEND_URL=http://backend:8000
